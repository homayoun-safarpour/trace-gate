include LICENSE README.md pyproject.toml requirements-ci.txt action.yml
recursive-include docs *.md *.svg *.json
recursive-include examples *.json *.txt
recursive-include scripts *.py
recursive-include integrations/promptfoo *.py *.json *.md *.txt *.log *.diff
recursive-include integrations/opentelemetry-js *.py *.json *.md *.cjs
recursive-include integrations/loop-engine *.py *.json *.md
recursive-include tests *.py
include .github/workflows/ci.yml .github/workflows/publish.yml
global-exclude *.py[cod]
global-exclude __pycache__
prune integrations/promptfoo/runtime-lock/node_modules
recursive-include integrations/consequence-bench *.py *.json *.md *.cjs *.js *.css *.html LICENSE
exclude integrations/consequence-bench/browser/parity-result.json
include .github/workflows/consequence-bench.yml .github/workflows/pr-recorded-trace.yml
